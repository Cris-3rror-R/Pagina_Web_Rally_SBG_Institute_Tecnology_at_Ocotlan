# FastAPI Configuration
ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# JWT Configuration (Optional - Supabase handles JWT)
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/rally_db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://rally.example.com

# Logging Configuration
LOG_LEVEL=INFO
